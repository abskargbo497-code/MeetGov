{
  "name": "govmeet-api",
  "version": "1.0.0",
  "description": "This an api for keep track of meeting and attendance",
  "keywords": [
    "ai",
    "agent",
    "transcription",
    "attendance",
    "minutes",
    "note"
  ],
  "license": "MIT",
  "author": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "validate:prisma": "node scripts/validate-prisma.js",
    "validate:redis": "node scripts/validate-redis.js",
    "validate": "npm run validate:prisma && npm run validate:redis",
    "postinstall": "prisma generate",
    "prebuild": "npm run validate",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "prestart": "npm run validate"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.11",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "@aws-sdk/client-s3": "^3.978.0",
    "@aws-sdk/s3-request-presigner": "^3.978.0",
    "@google-cloud/storage": "^7.18.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.2",
    "@sendgrid/mail": "^8.1.4",
    "@types/fluent-ffmpeg": "^2.1.28",
    "assemblyai": "^4.22.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.4.17",
    "bullmq": "^5.66.6",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "openai": "^6.17.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  }
}
