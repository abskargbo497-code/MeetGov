# Server Configuration
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# OpenAI API
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Storage (Legacy - if using GCS instead of R2)
STORAGE_BUCKET_NAME=your-bucket-name

# Redis
REDIS_URL=redis://default:password@host:port

# JWT & Authentication
JWT_SECRET=your_jwt_secret_here_use_base64_encoded_string
GUEST_SESSION_TTL_DAYS=7

# BetterAuth Configuration
BETTER_AUTH_SECRET=your_better_auth_secret_here_use_base64_encoded_string
BETTER_AUTH_URL=http://localhost:3001
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Application URLs
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# SendGrid Email Service
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Email Configuration
EMAIL_RECORDING_LINK_TTL_MINUTES=1440

# Cleanup Job Configuration
CLEANUP_INTERVAL_MINUTES=60
CLEANUP_LIMIT=50

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# R2 Signed URL TTL (optional, defaults provided)
SIGNER_UPLOAD_TTL_MINUTES=15
SIGNER_DOWNLOAD_TTL_MINUTES=60

# AssemblyAI Transcription Service
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ASSEMBLYAI_WEBHOOK_SECRET=your_assemblyai_webhook_secret_here
TRANSCRIPTION_PROVIDER=assemblyai

# Server Timeout Configuration (optional)
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=70000
HTTP_REQUEST_TIMEOUT_MS=120000

# Development Mode (optional)
DEV_MODE_BYPASS_MEETING_LIMIT=false
